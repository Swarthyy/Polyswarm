# PolySwarm 2.0 Configuration
# Copy this file to .env and fill in your values

# ======================
# TRADING MODE
# ======================
# PAPER = Log trades only (safe for testing)
# LIVE = Real order submission (requires wallet credentials)
TRADING_MODE=PAPER

# ======================
# SAFETY PARAMETERS
# ======================
# Maximum $ per trade
MAX_POSITION_SIZE=10

# Slippage tolerance (0.005 = 0.5%)
SLIPPAGE_TOLERANCE=0.005

# ======================
# WALLET CREDENTIALS (Required for LIVE mode only)
# ======================
# Your Polygon wallet private key (DO NOT SHARE)
# POLYGON_PRIVATE_KEY=0x...

# Optional: Proxy wallet address if using a trading proxy
# PROXY_ADDRESS=0x...
